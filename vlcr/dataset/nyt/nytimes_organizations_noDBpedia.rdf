  <rdf:Description rdf:about="http://data.nytimes.com/18381019937334802532">
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">130</nyt:associated_article_count>
    <owl:sameAs rdf:resource="http://data.nytimes.com/ebay_inc_org"/>
