  <rdf:Description rdf:about="http://data.nytimes.com/52570764151798349652">
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-10-04</nyt:latest_use>
    <skos:prefLabel xml:lang="en">Newark Museum</skos:prefLabel>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/organizations/n/newark_museum/index.html"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.newark_museum"/>
    <skos:definition xml:lang="en">The Newark Museum, founded in 1909, continues to be its own astonishing self: a world-embracing collection on a manageably human scale. After a four-year renovation was completed in 1989, the museum -- a complex that includes 80 galleries, a small zoo, planetarium and sculpture garden -- began to demand attention. Its collections include American, Asian and African art.
John Cotton Dana, a librarian and author, founded the museum in 1909. He served as its innovative first director until his death in 1929. Mr. Dana supported American artists and showed an interest in world cultures. Many of the museum's collections of Asian, particularly Tibetan and Japanese, and American art began under his tenure.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/newark_museum_org"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">18</nyt:associated_article_count>
