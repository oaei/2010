  <rdf:Description rdf:about="http://data.nytimes.com/3126412151266038982">
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
    <skos:prefLabel xml:lang="en">Army Corps of Engineers</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_org_facet%3A%5BArmy+Corps+of+Engineers%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">142</nyt:associated_article_count>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.united_states_army_corps_of_engineers"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/army_corps_of_engineers_org"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-09-22</nyt:first_use>
    <skos:definition xml:lang="en">The Army Corps of Engineers traces its past to June 16, 1775, when the Continental Congress included a post of chief engineer in the army it was forming. But over its history, the primary impact of the Corps has come from its work far from the battlefield -- in building public work projects, particularly dams and other flood control projects.
- July 10, 2007 Its efforts helped reshape the nation's economy, but in recent decades have come under increasing criticism from environmentalists. The grimmest passage in the Corps's history was the catastrophic failure of New Orleans's levees after Hurricane Katrina in 2005. A nine-volume report released by the Corps in June 2006 blasted almost every aspect of that work, calling the levee system a "system in name only.'' Reviews by some outside experts were even less flattering. Since then the Corps has been racing not only to rebuild flood protection for the city, but its reputation as well.</skos:definition>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-12-19</nyt:latest_use>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/organizations/a/army_corps_of_engineers/index.html"/>
  </rdf:Description>
