  <rdf:Description rdf:about="http://data.nytimes.com/50665755489087086182">
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-11-29</nyt:latest_use>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/organizations/g/guggenheim_solomon_r_museum/index.html"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-04-07</nyt:first_use>
    <skos:prefLabel xml:lang="en">Guggenheim, Solomon R, Museum</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
