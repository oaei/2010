  <rdf:Description rdf:about="http://data.nytimes.com/N41475840697860799772">
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-08-21</nyt:first_use>
    <skos:prefLabel xml:lang="en">Metro-North Commuter Railroad</skos:prefLabel>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">33</nyt:associated_article_count>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/organizations/m/metronorth_railroad/index.html"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_org_facet%3A%5BMetro-North+Commuter+Railroad%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-09-17</nyt:latest_use>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</nyt:number_of_variants>
    <skos:definition xml:lang="en">Metro-North Railroad is a commuter rail service operating under the auspices of New York City?s Metropolitan Transportation Authority. East of the Hudson River, it has three main lines extending out from Manhattan?s Grand Central Station: the New Haven, Harlem and Hudson Lines. West of the river run the Port Jervis and the Pascack Valley Lines, with a hub at the New Jersey Transit station in Hoboken, N.J.
The lines that now make up Metro-North used to be Conrail, but were acquired by the transportation authority in 1983. With 775 miles of track and average weekday ridership of 270,000 passengers, Metro-North is comparable in size to the Long Island Rail Road, its sister railroad in the transportation authority.</skos:definition>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.metro-north_railroad"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/metro_north_commuter_railroad_org"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
