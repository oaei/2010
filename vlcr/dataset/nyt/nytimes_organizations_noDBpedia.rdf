  <rdf:Description rdf:about="http://data.nytimes.com/6042330587037875542">
    <skos:prefLabel xml:lang="en">Menu Foods</skos:prefLabel>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-02-07</nyt:latest_use>
    <skos:definition xml:lang="en">On March 16, 2007, Menu Foods recalled more than 60 million cans and pouches of pet food that it are marketed under a variety of brand names. The company acted after receiving reports from owners that their pets had become ill.
News about the Menu Foods recall, including commentary and archival articles published in The New York Times.</skos:definition>
