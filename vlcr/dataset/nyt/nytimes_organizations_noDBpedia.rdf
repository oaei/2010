  <rdf:Description rdf:about="http://data.nytimes.com/12623826852075379742">
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.tribune_company"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</nyt:number_of_variants>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-11-23</nyt:latest_use>
    <skos:prefLabel xml:lang="en">Tribune Co</skos:prefLabel>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/tribune_co_org"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-06-06</nyt:first_use>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">36</nyt:associated_article_count>
    <skos:definition xml:lang="en">The Tribune Company, a media giant whose holdings also include the Chicago Cubs, filed for bankruptcy on Dec. 8, 2008, a little less than a year after being taken private in an $8.2 billion deal orchestrated by Sam Zell, a Chicago real-estate magnate.
The company owns 23 TV stations and 12 newspapers, including two of the eight largest in the country by circulation. As of Sept. 30, The Los Angeles Times had weekday circulation of 739,000 and the Chicago Tribune had 542,000. The company's Web site boasts that its properties reach 80 percent of the nation.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/news/business/companies/tribune_company/index.html"/>
