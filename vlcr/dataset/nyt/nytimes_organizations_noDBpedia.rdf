    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-08-03</nyt:first_use>
    <skos:prefLabel xml:lang="en">Starbucks Corp</skos:prefLabel>
  </rdf:Description>
