  <rdf:Description rdf:about="http://data.nytimes.com/78742968456423413272">
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.lehman_brothers"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/lehman_brothers_holdings_inc_org"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-08-02</nyt:first_use>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/news/business/companies/lehman_brothers_holdings_inc/index.html"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">219</nyt:associated_article_count>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</nyt:number_of_variants>
    <skos:definition xml:lang="en">Lehman Brothers was founded in 1850 by two cotton brokers in Montgomery, Ala. The firm moved to New York City after the Civil War and grew into one of Wall Street's investment giants. On Sept. 14, 2008, the investment bank announced that it would file for liquidation after huge losses in the mortgage market and a loss of investor confidence crippled it and it was unable to find a buyer.
Lehman's slow collapse began as the mortgage market crisis unfolded in the summer of 2007, when its stock began a steady fall from a peak of $82 a share. The fears were based on the fact that the firm was a major player in the market for subprime and prime mortgages, and that as the smallest of the major Wall Street firms, it faced a larger risk that large losses could be fatal.</skos:definition>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
    <skos:prefLabel xml:lang="en">Lehman Brothers Holdings Inc</skos:prefLabel>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-12-19</nyt:latest_use>
