  <rdf:Description rdf:about="http://data.nytimes.com/61835005359876685332">
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.walter_reed_army_medical_center"/>
    <skos:prefLabel xml:lang="en">Reed, Walter, Army Medical Center</skos:prefLabel>
    <skos:definition xml:lang="en">Walter Reed Army Medical Center is a vast hospital complex on the outskirts of Washington D.C., that the Army describes as the "clinical center of gravity of American military medicine." The larger Walter Reed Health Care System provides comprehensive health care for more than 150,000 soldiers, other service members, family members and retirees.
The center was founded in 1909 to integrate patient care, teaching and research. It was named after Major Walter Reed, best known for working to confirm the theory that yellow fever was caused by mosquitos.</skos:definition>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
