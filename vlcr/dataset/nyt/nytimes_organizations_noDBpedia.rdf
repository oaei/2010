  <rdf:Description rdf:about="http://data.nytimes.com/16634595303509653102">
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.consolidated_edison"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-08-01</nyt:first_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</nyt:number_of_variants>
