  <rdf:Description rdf:about="http://data.nytimes.com/66262715788581003682">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">46</nyt:associated_article_count>
