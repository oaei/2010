    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/news/business/companies/jetblue_airways_corporation/index.html"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-09-04</nyt:latest_use>
