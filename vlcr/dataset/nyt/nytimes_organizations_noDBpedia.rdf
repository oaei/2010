  <rdf:Description rdf:about="http://data.nytimes.com/60372172331045355522">
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_org_facet%3A%5BWilco%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</nyt:associated_article_count>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-07-05</nyt:latest_use>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <skos:definition xml:lang="en">Back in the 20th century, Wilco played roots-rock. It reached back to proven materials: the twang of country, the steady chug of 1960's rock, the undulating sheen of the Beach Boys, the honky-tonk hymns of the Band and the melodic symmetries of pop. Singing about certainties that had been left behind, the band's leader, Jeff Tweedy, held on to comforting forms.
? Jon Pareles Then he decided to set aside the sure things. On the band's extraordinary 2002 album, ''Yankee Hotel Foxtrot," songs about love, America, apocalypse and self-invention unfold in richly enigmatic arrangements. The music provides eerie terrain for Mr. Tweedy's homey melodies and his careworn voice, as songs drift from the familiar sounds of guitars and drums through layers of stray instruments, electronics and noise. The songs no longer seek the refuge of revived 1960's styles or the security of a clear-cut, vanished past. This time, the music wanders across odd, rewarding frontiers, where, at any moment, things can change.</skos:definition>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-09-29</nyt:first_use>
    <owl:sameAs rdf:resource="http://data.nytimes.com/wilco_org"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/organizations/w/wilco/index.html"/>
    <skos:prefLabel xml:lang="en">Wilco</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.wilco"/>
  </rdf:Description>
