  <rdf:Description rdf:about="http://data.nytimes.com/N14044897379121159422">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/news/business/companies/dell_inc/index.html"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
    <skos:definition xml:lang="en">Michael Dell invested $1,000 in startup capital to found a company in 1984 that would bypass the middleman to provide a custom-built computer directly to consumers. His success made him one of the wealthiest men in Texas and Dell the hyper-efficient predator of the personal computer business.
During past downturns in technology spending, the Dell Company tended to boast about its ability to weather the conditions better than competitors bogged down by higher-priced goods and cumbersome business models.
In 2009, the customary swagger has been noticeably absent. The decline in sales has proved so severe that Dell's earnings have fallen to the lowest level since 2002. In February the company reported that net income for the fourth quarter, ended Jan. 30, 2009, fell 48 percent, to $351 million from $679 million reported in the fourth quarter of the prior year. Revenue tumbled 16 percent, to $13.4 billion from $16 billion.</skos:definition>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-09-02</nyt:first_use>
    <skos:prefLabel xml:lang="en">Dell Inc</skos:prefLabel>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-12-17</nyt:latest_use>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">153</nyt:associated_article_count>
