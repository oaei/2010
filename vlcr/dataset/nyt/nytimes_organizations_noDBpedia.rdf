    <skos:prefLabel xml:lang="en">American Federation of Labor-Congress of Industrial Organizations</skos:prefLabel>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</nyt:number_of_variants>
