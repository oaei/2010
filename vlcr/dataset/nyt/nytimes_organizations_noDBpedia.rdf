    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.detroit_institute_of_arts"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-01-11</nyt:latest_use>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://data.nytimes.com/detroit_institute_of_arts_org"/>
    <skos:prefLabel xml:lang="en">Detroit Institute of Arts</skos:prefLabel>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/organizations/d/detroit_institute_of_arts/index.html"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-03-12</nyt:first_use>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</nyt:associated_article_count>
    <skos:definition xml:lang="en">The Detroit Institute of Arts, founded in 1885, is one of the country's small but classic encyclopedic museums. A master plan designed by the architect Michael Graves, reorganizing the museum's interior and expanding its gallery space by 31,000 square feet, was completed in 2007. The museum has more than 100 galleries, an 1,150-seat auditorium, a 380-seat lecture/recital hall, an art reference library, and a state-of-the-art conservation services laboratory.
Its collection encompasses a repository of creativity from prehistory through the 21st century, according to its website. William Valentiner, an art historian from Berlin who was director from 1924 to 1945, laid the groundwork for the institution through his European contacts and generous patrons. European masterpieces arrived: "St. Jerome in His Study," attributed to Jan van Eyck; "The Wedding Dance" by Pieter Bruegel the Elder; a Giovanni Bellini "Madonna and Child"; "Jacob van Ruisdael's "Jewish Cemetery." So did examples of Asian, African, pre-Colombian and Islamic art.</skos:definition>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
  </rdf:Description>
