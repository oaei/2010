  <rdf:Description rdf:about="http://data.nytimes.com/N13255942501025432092">
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.mahdi_army"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-07-12</nyt:first_use>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/organizations/m/mahdi_army/index.html"/>
    <skos:prefLabel xml:lang="en">Mahdi Army</skos:prefLabel>
    <skos:definition xml:lang="en">Since 2004, the most powerful force on the streets of Iraq after the American military has been the Mahdi Army, known in Arabic as the Jaish al-Mahdi. The group began as a small group of fighters who were fiercely loyal to Moktada al-Sadr, the firebrand Shiite imam, and grew rapidly in the months after the American invasion. The group's name reflected its religious roots -- for Shiites, the Mahdi is a messianic figure.
In April 2004 Mr. Sadr threw militia members into a fight against American troops in the city of Najaf and elsewhere across the Shiite south in a burst of self-assertion that took U.S. commanders by surprised and increased the group's stature.</skos:definition>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">122</nyt:associated_article_count>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
