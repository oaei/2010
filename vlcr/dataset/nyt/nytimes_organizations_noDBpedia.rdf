  <rdf:Description rdf:about="http://data.nytimes.com/N38649142237173228482">
    <owl:sameAs rdf:resource="http://data.nytimes.com/wells_fargo_co_org"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-12-31</nyt:latest_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.wells_fargo"/>
    <skos:definition xml:lang="en">No American bank has a more storied history than Wells Fargo.
Founded in In 1852 by Henry Wells and William Fargo, Wells, Fargo and Company became synonymous with the opening of the American West. The new company offered both banking -- with deposits in gold as well as in paper drafts backed by gold -- and express delivery of the gold and other valuables.
Wells Fargo first opened for business in San Francisco, and soon opened offices in other gold-rush boom towns and even mining camps. With demand for faster communications, Wells Fargo helped launch the Overland Mail Company in 1858. In 1861, it took over the Pony Express operations in the West. By 1866, the bank had united all the major Western stage lines.</skos:definition>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-10-18</nyt:first_use>
    <skos:prefLabel xml:lang="en">Wells Fargo &amp; Co</skos:prefLabel>
