  <rdf:Description rdf:about="http://data.nytimes.com/N74713508322097426022">
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">6</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.united_states_department_of_the_treasury"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/organizations/t/treasury_department/index.html"/>
    <skos:prefLabel xml:lang="en">Treasury Department</skos:prefLabel>
    <owl:sameAs rdf:resource="http://data.nytimes.com/treasury_department_org"/>
    <skos:definition xml:lang="en">The Treasury Department traces its history back to the tumult of the opening days of the Revolutionary War, when a cash-strapped Continental Congress decided in 1775 to issue paper money backed by nothing more than the promise of eventual repayment in coin, and enlisted residents of Philadelphia to number and count the bills. The department was formally created by Congress in 1789. The first Secretary of the Treasury was Alexander Hamilton, who shortly after being appointed took the bold move of proposing that the federal government assume the wartime debt of the states and pay them off in full.</skos:definition>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-09-10</nyt:first_use>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_org"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-12-28</nyt:latest_use>
