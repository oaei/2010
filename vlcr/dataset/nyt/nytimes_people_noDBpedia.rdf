    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BSosa%2C+Sammy%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.sammy_sosa"/>
    <skos:definition xml:lang="en">Updated June 17, 2009
Sammy Sosa, whose memorable home run duel with Mark McGuire captured the attention of baseball and the nation in the summer of 1998, may also be remembered infamously, as yet another star who became enmeshed in baseball's steroid scandal.
Sosa tested positive for performance enhancing drugs in 2003, according to lawyers with knowledge of baseball's drug-testing results from that year. The 2003 positive test could also create legal troubles for Sosa because he testified under oath before Congress at a public hearing in 2005 that he had "never taken illegal performance-enhancing drugs."</skos:definition>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/s/sammy_sosa/index.html"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">36</nyt:associated_article_count>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-09-15</nyt:first_use>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-08-10</nyt:latest_use>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <skos:prefLabel xml:lang="en">Sosa, Sammy</skos:prefLabel>
    <owl:sameAs rdf:resource="http://data.nytimes.com/sosa_sammy_per"/>
  </rdf:Description>
