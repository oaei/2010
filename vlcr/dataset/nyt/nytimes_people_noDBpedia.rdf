    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-07-05</nyt:latest_use>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2007-02-25</nyt:first_use>
    <skos:prefLabel xml:lang="en">Rohde, David</skos:prefLabel>
    <skos:definition xml:lang="en">Updated: Oct. 19, 2009
. Held by the Taliban David Stephenson Rohde is a New York Times reporter who was kidnapped by the Taliban in November 2008. He escaped on the night of June 19, 2009, and made his way to freedom after more than seven months of captivity in the mountains of Afghanistan and Pakistan. Mr. Rohde was part of The Times's reporting team that won a Pulitzer Prize in 2009 for coverage of Afghanistan and Pakistan. He gives his account of his experience as a captive in a five part series,</skos:definition>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</nyt:associated_article_count>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
