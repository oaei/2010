  <rdf:Description rdf:about="http://data.nytimes.com/46558697202341419423">
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.colin_powell"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</nyt:number_of_variants>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/p/colin_l_powell/index.html"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/powell_colin_l_per"/>
    <skos:definition xml:lang="en">Colin L. Powell is a former secretary of state, national security adviser and chairman of the Joint Chiefs of Staff, the first African-American to serve in any of those positions.
Over the course of his career Mr. Powell became one of America's most popular figures, representing to millions of people around the world the possibilities of the American dream. But Mr. Powell himself, as well as many opponents of the war in Iraq, consider that record tarnished by his service under President Bush, when he provided crucial support to the case that the threat of weapons of mass destruction justified the 2003 invasion.</skos:definition>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-09-10</nyt:first_use>
