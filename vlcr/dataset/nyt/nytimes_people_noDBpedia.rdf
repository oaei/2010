    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-12-20</nyt:first_use>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BRendell%2C+Edward+G%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://data.nytimes.com/rendell_edward_g_per"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">21</nyt:associated_article_count>
    <skos:definition xml:lang="en">has expertise on energy, transportation, education and manufacturing issues; broad knowledge of politics and personalities; and an instinctive feel for the concerns of urban, blue-collar and lower-income voters. Pennsylvania Gov. Edward G. Rendell of
Mr. Rendell, a Democrat, was an enthusiastic supporter of Senator Hillary Rodham Clinton, but campaigned hard for the Democratic ticket and helped deliver Pennsylvania to the Democrats on Nov. 4, 2008.
He was elected governor of Pennsylvania in 2002 largely on the basis of his reputation as mayor of Philadelphia, which prospered during his seven years in office. In 2006, Mr. Rendell won re-election handily over Lynn Swann, the retired Pittsburgh Steelers star. Before he served as mayor, Mr. Rendell served two terms as the district attorney of the City of Philadelphia, from 1978 through 1985.</skos:definition>
    <skos:prefLabel xml:lang="en">Rendell, Edward G</skos:prefLabel>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
