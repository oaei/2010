    <owl:sameAs rdf:resource="http://data.nytimes.com/clarke_arthur_c_per"/>
    <skos:prefLabel xml:lang="en">Clarke, Arthur C</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.arthur_c_clarke"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/c/arthur_c_clarke/index.html"/>
    <skos:definition xml:lang="en">The author of almost 100 books, Arthur C. Clarke was a writer whose seamless blend of scientific expertise and poetic imagination helped usher in the space age. He was an ardent promoter of the idea that humanity?s destiny lay beyond the confines of Earth. It was a vision served most vividly by ?2001: A Space Odyssey,? the classic 1968 science-fiction film he created with the director Stanley Kubrick and the novel of the same title that he wrote as part of the project.
His work was also prophetic: his detailed forecast of telecommunications satellites in 1945 came more than a decade before the first orbital rocket flight.</skos:definition>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</nyt:number_of_variants>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">6</nyt:associated_article_count>
  </rdf:Description>
