    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.paul_volcker"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">28</nyt:associated_article_count>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Volcker, Paul A</skos:prefLabel>
    <skos:definition xml:lang="en">Updated Oct. 21, 2009
Paul A. Volcker, who helped tame runaway inflation in the 1980s during two terms as chairman of the Federal Reserve, was named by President Barack Obama in February 2009 to lead the President’s Economic Recovery Advisory Board, a new White House committee. Mr. Obama called Mr. Volcker “one of the world’s foremost economic policy experts.”
The White House panel, made up of leading figures from a variety of business sectors, was set up to advise Mr. Obama on how to jump-start the economy and stabilize the financial markets.</skos:definition>
    <owl:sameAs rdf:resource="http://data.nytimes.com/volcker_paul_a_per"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-11-17</nyt:latest_use>
  </rdf:Description>
