  <rdf:Description rdf:about="http://data.nytimes.com/N725797334091130683">
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">17</nyt:associated_article_count>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-09-15</nyt:latest_use>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Coretta Scott King, known first as the wife of the Rev. Dr. Martin Luther King Jr., then as his widow, then as an avid proselytizer for his vision of racial peace and nonviolent social change, died early January 31, 2006. She was 78.
Mrs. King rose from rural poverty in Heiberger, Ala., to become an international symbol of the civil rights revolution of the 1960's and a tireless advocate for social and political issues ranging from women's rights to the struggle against apartheid in South Africa that followed in its wake.</skos:definition>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-08-17</nyt:first_use>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.coretta_scott_king"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/king_coretta_scott_per"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <skos:prefLabel xml:lang="en">King, Coretta Scott</skos:prefLabel>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
