    <skos:prefLabel xml:lang="en">Moussavi, Mir Hussein</skos:prefLabel>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/m/mir_hussein_moussavi/index.html"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.mir-hossein_mousavi"/>
