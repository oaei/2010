  <rdf:Description rdf:about="http://data.nytimes.com/N34891064719387023173">
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.tony_hillerman"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
