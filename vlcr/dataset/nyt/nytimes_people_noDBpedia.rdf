  <rdf:Description rdf:about="http://data.nytimes.com/86330751199186458853">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/stevens_ted_per"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">73</nyt:associated_article_count>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.ted_stevens"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/s/ted_stevens/index.html"/>
    <skos:definition xml:lang="en">Updated: April 7, 2009
, the recently installed attorney general, asked that all charges be dismissed because the new lawyers whom he had put in charge of the case had discovered yet another example of improperly withheld evidence by prosecutors. There would be no new trial in the case. Eric H. Holder Jr. On April 7, 2009, a federal judge dismissed the ethics conviction of former Senator Ted Stevens of Alaska, who narrowly lost his seat in November 2008 shortly after being convicted on seven felony counts of ethics violations.  The case collapsed April 1, more than five months after the verdict, when</skos:definition>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BStevens%2C+Ted%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
