  <rdf:Description rdf:about="http://data.nytimes.com/N46607548424773702223">
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</nyt:number_of_variants>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Spano, Andrew J</skos:prefLabel>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/s/andrew_j_spano/index.html"/>
    <skos:definition xml:lang="en">Updated July 20, 2009
Andrew J. Spano is the county executive of Westchester in New York State. A Democrat in what has become an increasingly Democratic county -- and one of the wealthier counties in the nation --  Mr. Spano is in his third four-year term in office.
But he faces opposition for re-election in 2009 from David Spano, one of his four adult children, who is collecting signatures for a spot on a third-party line, tentatively called Abolish County Government. David Spano, 49, a former auto mechanic and car salesman, has joined a small but noisy movement taking aim at county government as a symbol of waste and rising property taxes.</skos:definition>
    <owl:sameAs rdf:resource="http://data.nytimes.com/spano_andrew_j_per"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">24</nyt:associated_article_count>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-11-05</nyt:latest_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.andrew_spano"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-10-01</nyt:first_use>
