    <skos:prefLabel xml:lang="en">Musharraf, Pervez</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-12-19</nyt:latest_use>
