    <skos:prefLabel xml:lang="en">Quinn, Christine C</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/quinn_christine_c_per"/>
