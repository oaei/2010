    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BJohanns%2C+Mike%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-12-09</nyt:first_use>
    <skos:definition xml:lang="en">Michael Owens Johanns, known as Mike, was born on June 18, 1950 and grew up on a family dairy farm in Osage, Iowa. He left the state to attend college at St. Mary?s University in Minnesota and law school at Creighton University in Nebraska. Practicing law in Lincoln and O?Neill, Neb., he ran successfully for political office in Lancaster County and the City of Lincoln.
He was elected mayor of Lincoln in 1991 and re-elected in 1995. He was elected governor of Nebraska in 1998 and re-elected in 2002. During his tenure as governor he promoted the use of ethanol as a fuel, based on the state?s standing as the nation?s third largest producer of corn. He resigned to become U.S. Secretary of Agriculture in January, 2005. He left the Agriculture post in Sept. 2007 to prepare to seek the Republican nomination for the Nebraska U.S. Senate seat being vacated by Senator Chuck Hagel, also a Republican.</skos:definition>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</nyt:number_of_variants>
