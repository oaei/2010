  <rdf:Description rdf:about="http://data.nytimes.com/87490422268319654693">
    <skos:prefLabel xml:lang="en">Pace, Peter</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-04-21</nyt:first_use>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</nyt:associated_article_count>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.peter_pace"/>
    <skos:definition xml:lang="en">Gen. Peter Pace is the first Marine to serve as chairman of the Joint Chiefs of Staff, the nation's highest military post, but only the latest of a string of military commanders to have their careers cut short by the contention surrounding the conduct of the wars in Iraq and Afghanistan. On June 8, 2007, Defense Secretary Robert M. Gates announced that he was recommending to President Bush that General Pace not be nominated for a second two-year term because of the likely difficulty of winning confirmation.
General Pace's selection as chairman came after a 38-year career that began with graduation from the Naval Academy and has included postings in Vietnam, Somalia, Japan and Korea, as well as studies at George Washington University, where he earned a master's degree in business administration, and Harvard.</skos:definition>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
