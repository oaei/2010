  <rdf:Description rdf:about="http://data.nytimes.com/49558835702156649133">
    <skos:prefLabel xml:lang="en">Hagel, Chuck</skos:prefLabel>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
