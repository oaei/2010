  <rdf:Description rdf:about="http://data.nytimes.com/N24343564105792292533">
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-12-07</nyt:first_use>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
