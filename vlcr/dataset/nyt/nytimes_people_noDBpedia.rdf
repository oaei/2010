    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BPatinkin%2C+Mandy%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-09-19</nyt:latest_use>
    <skos:prefLabel xml:lang="en">Patinkin, Mandy</skos:prefLabel>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">8</nyt:associated_article_count>
    <skos:definition xml:lang="en">In his more than 30-year career, Mandy Patinkin has starred on television, in the movies, in theater and on the concert stage. He has been a principal character in three television series, ?Chicago Hope,? ?Dead Like Me? and ?Criminal Minds.?
He won a Tony Award as best featured actor in a musical for ?Evita? in 1980 and nominations for best actor in a musical for ?Sunday in the Park With George? in 1984 and ?The Wild Party? in 2000. His movie career has included roles in ?The Princess Bride,? ?Yentl? and ?Alien Nation.? He has released several successful compact discs, with specialties in Yiddish music and the work of Stephen Sondheim. He has toured the country and sung on Broadway in his one-man shows, and most recently teamed in concert with Patti LuPone. In summer-fall 2008, he is starring as Prospero in the Classic Stage Company?s Off Broadway production of William Shakespeare?s ?The Tempest.?</skos:definition>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/p/mandy_patinkin/index.html"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
