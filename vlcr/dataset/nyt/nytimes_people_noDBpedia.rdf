  <rdf:Description rdf:about="http://data.nytimes.com/44989032859427040013">
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-10-13</nyt:latest_use>
    <skos:prefLabel xml:lang="en">Sharpton, Al</skos:prefLabel>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BSharpton%2C+Al%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">79</nyt:associated_article_count>
    <owl:sameAs rdf:resource="http://data.nytimes.com/sharpton_al_per"/>
    <skos:definition xml:lang="en">The Rev. Al Sharpton Jr. is a minister and an activist. But the two words don't begin to describe his role, or suggest the countless times in the last few decades that his name has been associated with discussions about race and racial tensions in New York City and even the nation.
Sometimes his name comes up because the media often call on him when they want someone to speak for black America, even though he has never been elected to any office. Sometimes he has become involved in these matters because people who find themselves in trouble call on him, as Tawana Brawley's family did in 1987, when the young woman claimed she had been abducted and raped by a gang of white men, a claim that was later dismissed as a hoax by a special grand jury. He was called upon by the families in the so-called Jena Six case in Louisiana earlier this year, when six black high school students were arrested in the beating of a white classmate after a noose was hung on a schoolyard tree. Michael Richards, the comedian known for playing Kramer on the Seinfeld television hit, sought Mr. Sharpton's counsel in 2006 after he suffered what he later termed a meltdown during a comedy act at the Laugh Factory, where he repeatedly shouted a racial epithet at a black heckler, a scene disseminated over the Internet.</skos:definition>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/s/al_sharpton/index.html"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.al_sharpton"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-10-04</nyt:first_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
  </rdf:Description>
