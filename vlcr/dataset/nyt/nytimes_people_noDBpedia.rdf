  <rdf:Description rdf:about="http://data.nytimes.com/17819344373509153413">
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-04-19</nyt:latest_use>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://data.nytimes.com/flay_bobby_per"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.bobby_flay"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-01-06</nyt:first_use>
    <skos:definition xml:lang="en">Bobby Flay is the quintessence of a celebrity chef, known for his freewheeling interpretation of modern Southwestern cuisine, his championing of American cooking, his flair for publicity, his flamboyant, outgoing personality, his television programs and his cookbooks ? as well as the two New York restaurants that brought him his early success, Mesa Grill and Bolo.
Mr. Flay is an Iron Chef on ?Iron Chef America? on the Food Network. He has also had several cooking programs and specials on that network, including ?BBQ With Bobby Flay? and ?Boy Meets Grill.? But he is perhaps best known on television for an episode of the original ?Iron Chef,? when the Japanese program visited New York in 2000 for a ?Battle Rock Crab? between Mr. Flay and the Iron Chef Masaharu Morimoto. After Mr. Flay jumped up on his cutting board to raise his arms in premature victory, Mr. Morimoto angrily declared that his opponent is ?not a chef,? adding that in Japan, ?cutting boards and knives are sacred to us.? Mr. Flay lost (in a rematch the next year, he won).</skos:definition>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/f/bobby_flay/index.html"/>
    <skos:prefLabel xml:lang="en">Flay, Bobby</skos:prefLabel>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BFlay%2C+Bobby%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
