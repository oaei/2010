  <rdf:Description rdf:about="http://data.nytimes.com/71296598989711159073">
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-06-19</nyt:first_use>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-03-25</nyt:latest_use>
