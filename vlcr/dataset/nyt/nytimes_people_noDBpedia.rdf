  <rdf:Description rdf:about="http://data.nytimes.com/60619901482487428103">
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-03-05</nyt:first_use>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</nyt:number_of_variants>
