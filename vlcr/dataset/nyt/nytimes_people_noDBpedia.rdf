  <rdf:Description rdf:about="http://data.nytimes.com/920344336447429143">
    <skos:prefLabel xml:lang="en">Peterson, Oscar</skos:prefLabel>
    <owl:sameAs rdf:resource="http://data.nytimes.com/peterson_oscar_per"/>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BPeterson%2C+Oscar%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/p/oscar_peterson/index.html"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-09-25</nyt:latest_use>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.oscar_peterson"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">6</nyt:associated_article_count>
    <skos:definition xml:lang="en">Oscar Peterson 1925 - 2007
Oscar Peterson was a member of a generation that came of age in the 1950's and defined the public perception of a music that was popular, but no longer part of pop culture. Along with the Modern Jazz Quartet, Miles Davis, Gerry Mulligan and Dave Brubeck among others, he represented the collective public face of jazz. These were stars whose appeal took them beyond the dedicated audience.
For his entire career, Mr. Peterson resolutely made happy, exuberant music. There was an emotional honesty to his inventions, and virtuosity. His improvisations twist and turn, then suddenly burst with long greased lines that seem beyond the reach of most instrumentalists. He attracted attention to his music without making his work seem self-obsessed.</skos:definition>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-08-17</nyt:first_use>
  </rdf:Description>
