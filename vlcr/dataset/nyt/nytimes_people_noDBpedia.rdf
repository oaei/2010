  <rdf:Description rdf:about="http://data.nytimes.com/N44008769131325679423">
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">9</nyt:number_of_variants>
