  <rdf:Description rdf:about="http://data.nytimes.com/41981767799001001743">
    <skos:prefLabel xml:lang="en">Gregg, Judd</skos:prefLabel>
    <owl:sameAs rdf:resource="http://data.nytimes.com/gregg_judd_per"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-01-09</nyt:first_use>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Judd Gregg, a Republican who has represented New Hampshire in the Senate since 1993, was nominated by President Obama to be Commerce Secretary, but withdrew from consideration a week later, citing "irresolvable conflicts'' between himself and the Obama administration.
Mr. Gregg said that he and Obama officials "did not adequately focus on these concerns'' during discussions before the nomination. He said that disagreements over the stimulus bill and the handling of the 2010 Census led him to conclude that "we are functioning from a different set of views on many critical items of policy."</skos:definition>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-12-10</nyt:latest_use>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.judd_gregg"/>
