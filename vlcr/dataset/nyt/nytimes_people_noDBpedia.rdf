  <rdf:Description rdf:about="http://data.nytimes.com/N19645390599174875653">
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">44</nyt:associated_article_count>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-12-20</nyt:latest_use>
    <owl:sameAs rdf:resource="http://data.nytimes.com/taylor_paul_per"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.paul_taylor"/>
    <skos:definition xml:lang="en">Paul Taylor is one of the few living choreographers whose works stand as classics. And he alone is so enshrined in the hearts of the New York public that a season by his 54-year-old modern-dance company, presenting a mixture of new pieces, old favorites and revivals of long-unseen works, is an annual fixture.
On Feb. 28, the Paul Taylor Dance Company opened at City Center with a triple bill that included ?De SueÃ±os? (?Of Dreams?), a centerpiece ? with its companion work, ?De SueÃ±os Que Se Repiten? (?Of Recurring Dreams?) ? of the season. Those pieces, 2 of the 19 to be performed during the City Center season, are among the trickiest and most visually sumptuous Mr. Taylor has produced in the 20 years he has worked with the lighting designer Jennifer Tipton and the set and costume desiger Santo Loquasto. These days Mr. Taylor, 77, works on new pieces for about 90 minutes a day, four days a week, during the company?s six-week rehearsal period.</skos:definition>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-03-02</nyt:first_use>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/t/paul_taylor/index.html"/>
