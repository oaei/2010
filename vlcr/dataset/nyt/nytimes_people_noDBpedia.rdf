  <rdf:Description rdf:about="http://data.nytimes.com/18031245559830271303">
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-03-22</nyt:latest_use>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.kathleen_soliah"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</nyt:associated_article_count>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/o/sara_jane_olson/index.html"/>
    <skos:definition xml:lang="en">Sara Jane Olson was charged in 1975 with trying to bomb police cars with the Symbionese Liberation Army, a group best known for kidnapping the newspaper heiress Patricia Hearst.
In 2001, Ms. Olson, who was known at the time of her crimes as Kathleen Soliah, pleaded guilty to attempting to murder two Los Angeles police officers with a bomb planted under their car. She has been sentenced to 14 years in that case.
She was arrested in Minnesota, where she lived with her husband, an emergency room physician, and their three children. Her brother Stephen Soliah was acquitted in the 1976 trial for the bank robbery.</skos:definition>
