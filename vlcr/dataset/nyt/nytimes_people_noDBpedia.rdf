  <rdf:Description rdf:about="http://data.nytimes.com/21119998313125565473">
    <owl:sameAs rdf:resource="http://data.nytimes.com/wasserstein_bruce_per"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-09-27</nyt:first_use>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">26</nyt:associated_article_count>
