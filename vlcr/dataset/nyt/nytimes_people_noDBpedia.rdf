    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/a/bertie_ahern/index.html"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://data.nytimes.com/ahern_bertie_per"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.bertie_ahern"/>
    <skos:definition xml:lang="en">Bertie Ahern became Taoiseach, or prime minister, of Ireland in 1997 and announced on April 2, 2008 that he would step down the next month in the face of corruption inquiries. He had been one of Europe's longest-serving leaders, and had presided not only over Ireland's remarkable economic revival but over negotiations that led to the "Good Friday Agreement'' that ended Northern Ireland's civil war in 1997.
Mr. Ahern had earlier weathered accusations of corruption in the 1990s, when he was finance minister, but in stepping down he said he was quitting to prevent his government?s work from being ?constantly deflected by the minutiae of my life, my lifestyle and my finances.? A tribunal is investigating accusations that Irish politicians received payments from real-estate developers in return for favorable planning decisions. Mr. Ahern predicted that the panel would find that he had not acted improperly.</skos:definition>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">12</nyt:associated_article_count>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-04-03</nyt:latest_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
  </rdf:Description>
