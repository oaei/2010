  <rdf:Description rdf:about="http://data.nytimes.com/50597049862830432113">
    <owl:sameAs rdf:resource="http://data.nytimes.com/rockwell_david_per"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-10-10</nyt:first_use>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <skos:definition xml:lang="en">David Rockwell, the son of a musical theater choreographer, has become the country's leading choreographer of visual imagery in public places. From his early notoriety as a restaurant designer — Vong, the Monkey Bar, nearly 60 Planet Hollywoods, a slew of Nobus — Mr. Rockwell has emerged as architecture's Flo Ziegfeld, an unabashed proponent of what he calls ''the immersive experience'' or sometimes just ''the Big Wow.''
An artful diviner of popular taste, Mr. Rockwell embeds his many designs with narratives: the public spaces at the Terminal 5 at Kennedy International Airport, home to JetBlue Airways, were inspired by “the dance of New York,” transformed into physical form with the help of Jerry Mitchell, a choreographer and frequent collaborator.</skos:definition>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.david_rockwell"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">16</nyt:associated_article_count>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
