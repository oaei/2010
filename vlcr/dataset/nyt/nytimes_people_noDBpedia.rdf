  <rdf:Description rdf:about="http://data.nytimes.com/51613381561155031213">
    <skos:prefLabel xml:lang="en">Mitchell, Joni</skos:prefLabel>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <skos:definition xml:lang="en">? Jon Pareles For three decades Joni Mitchell wrote songs that were equally daring in their personal revelations and their musical restlessness. They traced a woman?s romantic and intellectual life in progress, from bright-eyed aspiration to cosmopolitan wanderlust to political bitterness, from folky sweetness to pop sheen to open-ended, jazzy excursions. Along the way her music spawned countless disciples and admirers.</skos:definition>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.joni_mitchell"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-05-31</nyt:latest_use>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
