    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/a/raul_alfonsin/index.html"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
