    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Bush, Laura</skos:prefLabel>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-09-01</nyt:first_use>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BBush%2C+Laura%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <skos:definition xml:lang="en">Laura Bush, wife of President George W. Bush, worked as an elementary school teacher and librarian in Texas for over 10 years before marrying at age 32. Mrs. Bush was first lady of Texas when Mr. Bush served as governor before coming to the White House.
She was born Laura Welch on Nov. 4, 1946, the only child of Harold and Jenna Welch. Her father was a real-estate developer, and her mother worked as a secretary at his firm.
Mrs. Bush received a B.A. in education from Southern Methodist University in Dallas in 1968; in 1974 she earned a M.A. in library science from the University of Texas.</skos:definition>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/b/laura_bush/index.html"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/bush_laura_per"/>
