  <rdf:Description rdf:about="http://data.nytimes.com/N45512316511116172533">
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/l/abner_louima/index.html"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-12-29</nyt:first_use>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-10-27</nyt:latest_use>
    <skos:prefLabel xml:lang="en">Louima, Abner</skos:prefLabel>
    <skos:definition xml:lang="en">On Aug. 9, 1997, more than three years into Mayor Rudolph W. Giuliani?s first term, a 30-year-old Haitian immigrant named Abner Louima was arrested and brutalized by a white police officer inside the restroom of the 70th Precinct station house in Brooklyn. The attack became a national symbol of police brutality and fed perceptions that white police officers in New York were harassing or abusing young black men as part of a citywide crackdown on crime.
One officer, Justin A. Volpe, admitted in court in May 1999 that he had rammed a broken broomstick into Mr. Louima?s rectum, and then had thrust it in his face. He said he had mistakenly believed that Mr. Louima had punched him in the head during a street brawl outside a nightclub, but he acknowledged that he had also intended to humiliate the handcuffed immigrant. He left the force and was later sentenced to 30 years in prison. The commanders of the 70th Precinct were replaced within days of the assault.</skos:definition>
    <owl:sameAs rdf:resource="http://data.nytimes.com/louima_abner_per"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">7</nyt:associated_article_count>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.abner_louima"/>
