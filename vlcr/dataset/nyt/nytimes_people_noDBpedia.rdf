  <rdf:Description rdf:about="http://data.nytimes.com/55462503055180734053">
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.lorrie_moore"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/moore_lorrie_per"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/m/lorrie_moore/index.html"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</nyt:associated_article_count>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-04-23</nyt:first_use>
    <skos:definition xml:lang="en">Lorrie Moore's fans are ardent, even cultish, and have been increasing ever since she arrived on the literary scene in 1985 with the publication of “Self-Help,” a short story collection that was Ms. Moore's masters thesis at Cornell University. Writing in the New York Times, Michiko Kakutani praised her “wry, crackly voice” and “askew sense of humor,” deeming her “a writer of enormous talent.”
As one of the most nuanced writers working today, Ms. Moore is as likely to write about sweeping themes as she is to deliver sharp-witted and trenchant observations about life's small moments. Ms. Moore followed up on her debut with a novel, "Anagrams," then another short collection, “Like Life,” a short novel, “Who Will Run the Frog Hospital,” and then “Birds of America,” a 1998 short story collection that was widely praised and broke onto The New York Times hardcover fiction best-seller list for five weeks.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-09-02</nyt:latest_use>
    <skos:prefLabel xml:lang="en">Moore, Lorrie</skos:prefLabel>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BMoore%2C+Lorrie%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
