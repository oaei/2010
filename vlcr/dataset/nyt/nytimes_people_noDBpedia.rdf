    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/z/robert_b_zoellick/index.html"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-12-10</nyt:first_use>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.robert_zoellick"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Robert B. Zoellick, a former deputy secretary of state and Goldman Sachs executive, is president of the World Bank. As deputy secretary, Mr. Zoellick was the primary architect of the Bush administration's policy toward Sudan. He also served as U.S. trade representative from February 2001 to February 2005. On May 29, 2008, administration officials said that President Bush had chosen Mr. Zoellick to lead the World Bank and try to heal the bitter rifts left by the ouster of Paul D. Wolfowitz.</skos:definition>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-07-10</nyt:latest_use>
