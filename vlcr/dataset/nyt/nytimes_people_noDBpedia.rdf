  <rdf:Description rdf:about="http://data.nytimes.com/38859886559826729023">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">42</nyt:associated_article_count>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.sumner_redstone"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/r/sumner_m_redstone/index.html"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/redstone_sumner_m_per"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-11-04</nyt:latest_use>
    <skos:prefLabel xml:lang="en">Redstone, Sumner M</skos:prefLabel>
    <skos:definition xml:lang="en">Beginning with a modest chain of drive-in movie theaters, Sumner M. Redstone has negotiated, sued and otherwise fought to amass the multibillion-dollar Viacom empire that included the television network CBS Inc., the film and television studio Paramount Communications, the leading book publisher Simon &amp; Schuster, the video retail giant Blockbuster Entertainment Corporation and a slew of profitable cable channels, among other properties.
The same tenacity Mr. Redstone has displayed in business helped save his life. At age 55, he survived a fire that engulfed his Boston hotel room by clinging to a window ledge while half his body was scorched.</skos:definition>
