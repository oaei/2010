    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2007-01-05</nyt:first_use>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BPetraeus%2C+David+H%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-12-06</nyt:latest_use>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">112</nyt:associated_article_count>
    <skos:prefLabel xml:lang="en">Petraeus, David H</skos:prefLabel>
    <owl:sameAs rdf:resource="http://data.nytimes.com/petraeus_david_h_per"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/news/international/countriesandterritories/iraq/iraqprogressreports/index.html"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.david_petraeus"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Assessing the 'Surge'
When President Bush announced in January 2007 that he was sending more troops to Iraq, he was running counter both to the tide of public opinion, which had swept Democrats into control of Congress in the November 2006 elections, and to the advice of the bipartisan Baker-Hamilton commission, which recommended reducing the number of combat troops. Mr. Bush and the new commander he had put in charge of ground forces in Iraq, Gen. David H. Petraeus, argued that a "surge'' of troops could help stabilize the war-torn country, which would give Iraqi politicians some breathing space to forge a consensus among Sunnis, Shiites and Kurds.</skos:definition>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</nyt:number_of_variants>
  </rdf:Description>
