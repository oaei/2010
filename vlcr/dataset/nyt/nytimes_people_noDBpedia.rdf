  <rdf:Description rdf:about="http://data.nytimes.com/22265152672301758583">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/p/mark_penn/index.html"/>
    <skos:definition xml:lang="en">Mark Penn is a pollster who has served as an adviser to Bill and Hillary Clinton since 1996, and who was the chief political strategist for Mrs. Clinton's presidential campaign. Mr. Penn stepped down from that post on April 6, 2008, after news reports revealed that he had met with Colombian officials who had hired him to help secure passage of a bilateral trade treaty with the United States that Mrs. Clinton, a senator from New York, opposed.
It was not the first time that Mr. Penn's private business dealings had clashed with Mrs. Clinton's positions. He met with the Colombians in his role as chief executive of Burson-Marsteller, a global public relations firm. He has refused to sever his ties to the company, which also represented Countrywide Financial, the nation?s largest mortgage lender, and through a subsidiary represented Blackwater Worldwide, the military contractor blamed for numerous civilian deaths in Iraq.</skos:definition>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.mark_penn"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-07-06</nyt:latest_use>
