  <rdf:Description rdf:about="http://data.nytimes.com/66718220655542665223">
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-09-08</nyt:first_use>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5Bbin+al-Shibh%2C+Ramzi%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</nyt:number_of_variants>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-03-10</nyt:latest_use>
    <owl:sameAs rdf:resource="http://data.nytimes.com/bin_al_shibh_ramzi_per"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">6</nyt:associated_article_count>
    <skos:prefLabel xml:lang="en">bin al-Shibh, Ramzi</skos:prefLabel>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/b/ramzi_bin_alshibh/index.html"/>
    <skos:definition xml:lang="en">Updated: Nov. 13, 2009
, mastermind of the attacks of Sept. 11, 2001, is believed to have had a cadre of al-Qaeda accomplices who were the money men, travel agents and deputies who enabled the hijackers in the United States from their posts overseas. Khalid Sheikh Mohammed
On Nov. 13, 2009, a federal official said that Mr. Mohammed and four other men would be tried in New York City for the attacks. Among them was Ramzi Omar.
Ramzi Omar, also known as Ramzi Binalshibh, is believed to have been the primary contact between the organizers of the Sept. 11 hijackers.</skos:definition>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.ramzi_binalshibh"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
