    <skos:prefLabel xml:lang="en">Carter, Jimmy</skos:prefLabel>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">92</nyt:associated_article_count>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <skos:definition xml:lang="en">James Earl Carter grew up on a farm with no plumbing or electricity but realized his dream of attending the U.S. Naval Academy, after which he joined the submarine fleet and studied nuclear physics. He left the Navy in 1953 to run the family peanut business, was elected to the Georgia state senate in 1962, and became governor in 1970. Mr. Carter's, homespun style and vows of honesty struck a chord with voters after Watergate, and he defeated the incumbent, Gerald R. Ford, for the presidency in 1976.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
  </rdf:Description>
