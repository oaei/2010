  <rdf:Description rdf:about="http://data.nytimes.com/88920602637711184223">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Serra, Richard</skos:prefLabel>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/s/richard_serra/index.html"/>
    <skos:definition xml:lang="en">Richard Serra is one of America's most esteemed artists. In the decades since he first started assembling immense steel plates into ''site-specific'' sculptures — his best-known pieces are created for bustling urban plazas — he has risen from the ranks of the 1960's avant-garde into the annals of art history.
A vocal leftist, he first made a name for himself with splashed-lead sculptures designed to challenge the tradition of the collectible art object and the patronage system by which art is bought and sold.
For all the respect he commands within the art world, Serra has been described as the most notorious sculptor in America. His work has been called ''garbage,'' ''hideous,'' ''dehumanized,'' ''an irritant,'' ''a calculated offense,'' ''scrap iron'' — to borrow the appraisals of irate office workers who in 1985 testified against a Serra sculpture that had been placed in their midst.</skos:definition>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.richard_serra"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-12-04</nyt:latest_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
