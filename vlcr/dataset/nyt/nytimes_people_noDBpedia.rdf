  <rdf:Description rdf:about="http://data.nytimes.com/64937244746581938423">
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-03-11</nyt:latest_use>
    <skos:prefLabel xml:lang="en">Carlson, Tucker</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-08-27</nyt:first_use>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.tucker_carlson"/>
    <skos:definition xml:lang="en">Tucker Carlson is a television commentator known for his conservative views and, until recently, his trademark bow tie.
A print journalist turned television pundit, Mr. Carlson served as a co-host of the CNN shows "The Spin Room'' and "Crossfire'' and as host of "Tucker Unfiltered'' on PBS. After being dropped from "Crossfire,'' Mr. Carlson joined MSNBC, becoming the (bow-tie-less) host of a one-hour early evening talk show called "Tucker.''
The show never developed high ratings, and on March 10, 2008, MSNBC announced that it was dropping Mr. Carlson's show and replacing it one with hosted by NBC's chief White House correspondent David Gregory. Mr. Carlson, who will remain a campaign correspondent, said that his views had been "out of sync'' with the more liberal bent of MSNBC's marquee talk shows, though he added "it's not my nature to cry bias.''</skos:definition>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/c/tucker_carlson/index.html"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</nyt:associated_article_count>
