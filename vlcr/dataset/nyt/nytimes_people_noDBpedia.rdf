    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BHirst%2C+Damien%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/h/damien_hirst/index.html"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-10-18</nyt:latest_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">33</nyt:associated_article_count>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.damien_hirst"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Damien Hirst, winner of the 1995 Turner Prize, is one of the so-called Young British Artists who became international art world celebrities after the advertising magnate Charles Saatchi relentlessly promoted them. Mr. Hirst's work is purposely provocative and disturbing. Among his most famous pieces are dead rotting cows positioned to simulate copulation, sharks and sheep preserved in formaldehyde, and maggots attacking a cow's head. He has also produced glass-fronted shelves filled with hundreds of bottles and boxes of drugs, cabinets displaying animal skeletons and paintings of colorful dots and swirls.</skos:definition>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://data.nytimes.com/hirst_damien_per"/>
  </rdf:Description>
