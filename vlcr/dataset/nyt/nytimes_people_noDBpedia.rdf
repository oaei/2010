    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">13</nyt:associated_article_count>
    <skos:prefLabel xml:lang="en">Sendak, Maurice</skos:prefLabel>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.maurice_sendak"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/sendak_maurice_per"/>
