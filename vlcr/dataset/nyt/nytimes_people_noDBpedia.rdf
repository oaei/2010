    <skos:prefLabel xml:lang="en">Morris, Dick</skos:prefLabel>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BMorris%2C+Dick%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <owl:sameAs rdf:resource="http://data.nytimes.com/morris_dick_per"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.dick_morris"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-09-09</nyt:first_use>
    <skos:definition xml:lang="en">Dick Morris is a political pundit and a former political campaign pollster and consultant. He served as a close but informal advisor during Bill Clinton's first term and was manager of Clinton's 1996 re-election campaign, and is credited with pushing Clinton towards "third-way" or "triangulation" politics, in which traditional Democratic and Republican strategies and rhetoric are mixed to achieve the most powerful political appeal.
Morris resigned from the Clinton campaign after reports that he had been seeing a prostitute and had allowed her to listen in on calls to the White House. He is now a columnist for the New York Post and is a regular commenter on FOX News.</skos:definition>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-11-18</nyt:latest_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</nyt:associated_article_count>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/m/dick_morris/index.html"/>
  </rdf:Description>
