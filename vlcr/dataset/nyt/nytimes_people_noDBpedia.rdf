    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/g/savion_glover/index.html"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.savion_glover"/>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BGlover%2C+Savion%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <skos:prefLabel xml:lang="en">Glover, Savion</skos:prefLabel>
    <skos:definition xml:lang="en">. Claudia La Rocco, June 18, 2007 Aggressive and political, "Bring In da Noise, Bring In da Funk" fundamentally altered the tap landscape when it burst onto Broadway in 1996. Savion Glover's hit show launched a new generation of hard-hitting young dancers, even as it saddled them with the unfortunate misnomer "hip-hop tap." Mr. Glover, now 33, was just out of his teens when "Noise/Funk" established its virtuosic star as a household name-for many, the only name in tap. In the intervening decade, he has drifted away from many of his fellow tap dancers, eschewing tap events and festivals in favor of his own projects, like an intimate collaboration with a gospel singer at the Joyce Theater, or a motion-capture adventure in Hollywood as the dancing penguin Mumbles in "Happy Feet." Whatever the endeavor, there remains one constant: those magical, unstoppable feet.--</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
