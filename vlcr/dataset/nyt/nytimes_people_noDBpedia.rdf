  <rdf:Description rdf:about="http://data.nytimes.com/N62918898437396736013">
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-12-19</nyt:latest_use>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-06-03</nyt:first_use>
