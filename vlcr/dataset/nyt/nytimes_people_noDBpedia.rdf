  <rdf:Description rdf:about="http://data.nytimes.com/N88654385598940035913">
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2007-04-04</nyt:first_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <skos:definition xml:lang="en">Monica M. Goodling was an aide to Attorney General Alberto R. Gonzales before she resigned on April 6, 2007, in the midst of investigations into the firing of federal prosecutors.
At the Justice Department, she served as the liaison with the White House. Ms. Goodling is a 1999 graduate of the law school at Regent University, founded by the television evangelist Pat Robertson; she was hired by Mr. Gonzales despite having only six months of prosecutorial experience. When subpoenaed by the House Judiciary Committee on her role in the firings, Ms. Goodling initially refused to testify, claiming her right against self-incrimination under the Fifth Amendment, and agreed to appear only after being granted immunity from prosecution.</skos:definition>
    <skos:prefLabel xml:lang="en">Goodling, Monica</skos:prefLabel>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-10-01</nyt:latest_use>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.monica_goodling"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</nyt:associated_article_count>
