    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</nyt:number_of_variants>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/h/henry_j_hyde/index.html"/>
    <skos:definition xml:lang="en">Henry J. Hyde was an influential Republican Congressman from Illinois who was an ardent opponent of abortion, but whose greatest fame came as the lead prosecutor in the impeachment trial of President Clinton.
His best-known piece of legislation was the Hyde Amendment, which barred the use of federal funds to pay for abortion.
While his public image was largely defined first by the abortion issue and then by impeachment, within the House Mr. Hyde had a more complex political persona. He supported extending the Voting Rights Act in 1981, championed many foreign aid measures and family leave legislation, and backed Mr. Clinton over a ban on assault weapons. But he also supported aid to the Nicaraguan contras and backed constitutional amendments requiring a balanced budget and prohibiting abortions, flag-burning and same-sex marriages.</skos:definition>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</nyt:associated_article_count>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <skos:prefLabel xml:lang="en">Hyde, Henry J</skos:prefLabel>
    <owl:sameAs rdf:resource="http://data.nytimes.com/hyde_henry_j_per"/>
  </rdf:Description>
