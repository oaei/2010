    <owl:sameAs rdf:resource="http://data.nytimes.com/glover_savion_per"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-11-21</nyt:latest_use>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-01-02</nyt:first_use>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</nyt:associated_article_count>
