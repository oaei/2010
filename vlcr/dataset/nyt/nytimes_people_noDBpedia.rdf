    <owl:sameAs rdf:resource="http://data.nytimes.com/schilling_curt_per"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/s/curt_schilling/index.html"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.curt_schilling"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-03-24</nyt:latest_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">72</nyt:associated_article_count>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-09-23</nyt:first_use>
    <skos:definition xml:lang="en">Curt Schilling is a power pitcher and power talker who has been a center of attention on and off the mound in Arizona and Boston. He announced on June 20, 2008, that a shoulder injury that had kept him off the Red Sox' active roster for the first half of the season, required surgery that would end his season and possibly his career.
Schilling, who is 216-146 with a 3.46 earned run average in his career, left an indelible, bloody mark on Red Sox history in 2004. With Boston facing elimination against the Yankees in Game 6 of the American League Championship Series, Schilling, who had a loose tendon in his ankle sutured, guided them to the win. He pitched with blood stains on his sock. Schilling also won Game 2 of the World Series and the Red Sox subsequently won their first title in 86 years.</skos:definition>
    <skos:prefLabel xml:lang="en">Schilling, Curt</skos:prefLabel>
  </rdf:Description>
