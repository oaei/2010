  <rdf:Description rdf:about="http://data.nytimes.com/N80134510745839553683">
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</nyt:associated_article_count>
    <skos:prefLabel xml:lang="en">Knowles, Beyonce</skos:prefLabel>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-11-28</nyt:first_use>
    <skos:definition xml:lang="en">Beyoncé Knowles is one of the few pop stars left with a wholesome, good-girl image. Ms. Knowles's latest film is "Cadillac Records" in which she plays the legendary blues singer Etta James, a former heroin addict and the daughter of a prostitute. Her role as the hard-living and emotionally scarred singer altered the direction of her latest album, “I Am...Sasha Fierce” (Music World/Columbia Records). The film opened in December 2008.
“I was surprised at how much Beyoncé threw the glamour out the window so easily and so joyfully, and embraced the unattractiveness of being strung out,” said Darnell Martin, the writer and director of "Cadillac Records," which tells the story of Chess Records, the pioneering Chicago blues label. Though the role was written with Ms. Knowles in mind, Ms. Martin said she was impressed by how far the actress pushed herself, physically and emotionally, into the darkest parts of Ms. James’s life. Ms. Knowles's previous work in "Dreamgirls" (2006) earned her a Golden Globe nomination.</skos:definition>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-12-06</nyt:latest_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/k/beyonce_knowles/index.html"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/knowles_beyonce_per"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</nyt:number_of_variants>
