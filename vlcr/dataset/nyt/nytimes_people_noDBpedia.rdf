  <rdf:Description rdf:about="http://data.nytimes.com/76375616153020735013">
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.jack_reed"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/r/jack_reed/index.html"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-06-08</nyt:first_use>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">6</nyt:associated_article_count>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Reed, Jack</skos:prefLabel>
    <skos:definition xml:lang="en">In the United States Senate, Jack Reed has cultivated his power quietly by garnering the respect of his colleagues. Through special waver, he holds seats on both the armed services and appropriations committees. Rhode Island?s senior senator is often mentioned as a possible defense secretary or vice president in a Democratic White House.
A former Army Ranger and paratrooper, Mr. Reed is perhaps best known for his grasp of military issues. Though he voted against the invasion of Iraq in 2003, he has visited the country about a dozen times since the war began ? most recently with Senator Barack Obama of Illinois during his first trip abroad as a presidential candidate. He has pushed for increases in the size of the military, and in 2007, Democrats unsuccessfully tried to pass an amendment that Mr. Reed co-sponsored to a defense spending bill to begin withdrawing troops from Iraq within 120 days.</skos:definition>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BReed%2C+Jack%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
