    <skos:definition xml:lang="en">Apolo Anton Ohno is an American Olympic champion in short-track speed skating. He won a gold and a silver medal at the 2002 Olympics in Salt Lake City, Utah, followed by one gold and two bronze at the 2006 Olympic competition in Turin, Italy.
-- March 25, 2008 His competitiveness pushed him further into the public eye when in 2007 he became the top dancer of the season on the TV show ?Dancing With the Stars.? Mr. Ohno continues to compete as a skater, and has announced his intentions to train for the 2010 games in Vancouver, Canada.</skos:definition>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-12-16</nyt:first_use>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">11</nyt:associated_article_count>
    <skos:prefLabel xml:lang="en">Ohno, Apolo Anton</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
