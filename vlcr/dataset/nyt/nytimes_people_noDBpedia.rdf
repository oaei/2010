  <rdf:Description rdf:about="http://data.nytimes.com/N24363764210345570053">
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">0</nyt:associated_article_count>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/p/duke_of_edinburgh_philip/index.html"/>
    <skos:definition xml:lang="en">Prince Philip, Duke of Edinburgh, Earl of Merioneth and Baron Greenwich was born in Corfu in 1921. He married Queen Elizabeth II in 1947, and gave up his title as Prince of Greece and Denmark to become a British subject.
The prince participated in World War II in the Royal Navy and remained in service until 1952, when his wife became Queen.
Though he holds no constitutional role, he accompanies the queen on all overseas visits and supports many industries, councils and foundations of his own interest.</skos:definition>
    <owl:sameAs rdf:resource="http://data.nytimes.com/philip_duke_of_edinburgh_per"/>
    <skos:prefLabel xml:lang="en">Philip, Duke Of Edinburgh</skos:prefLabel>
