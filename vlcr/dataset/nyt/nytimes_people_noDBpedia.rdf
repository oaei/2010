    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/o/david_r_obey/index.html"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-10-11</nyt:latest_use>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-12-12</nyt:first_use>
    <skos:prefLabel xml:lang="en">Obey, David R</skos:prefLabel>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.dave_obey"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">7</nyt:associated_article_count>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <skos:definition xml:lang="en">David R. Obey, born Oct. 3, 1938, is chairman of the House Appropriations Committee and has spent 40 years in Congress as a champion of federal spending. The prickly Wisconsin Democrat is the leader behind the $825 billion economic package that is headed toward a vote on the last week of January 2009.
The third-most-senior member of the House, Mr. Obey has, in large measure, shaped the bill, in concert with other House Democratic leaders. The plan is expected to pass. Mr. Obey, 70, who is the product of a Catholic blue-collar upbringing in Wausau, said that if he had sole ownership, he would have turned out a costlier measure with more health spending.</skos:definition>
  </rdf:Description>
