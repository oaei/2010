    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Kathie Lee Gifford spent many of her days in showbiz opening in nightclubs and casinos for the likes of Milton Berle and Rodney Dangerfield. But, in the mid-80?s, she joined a morning talk show that evolved into the nationally syndicated "Live With Regis and Kathie Lee" propelling her to national fame. She co-hosted the program with Regis Philbin for 15 years, leaving in 2000.
That exposure afforded her several opportunities: she has recorded solo CD's, published books, penned and performed in musicals and has sung in major jazz halls. She also opened her own clothing line, a venture that brought much unwanted attention when it was discovered that some of her company?s merchandise was manufactured in a sweatshop.</skos:definition>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.kathie_lee_gifford"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/g/kathie_lee_gifford/index.html"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/gifford_kathie_lee_per"/>
    <skos:prefLabel xml:lang="en">Gifford, Kathie Lee</skos:prefLabel>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-12-06</nyt:latest_use>
