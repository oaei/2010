  <rdf:Description rdf:about="http://data.nytimes.com/90960315011943301573">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">8</nyt:associated_article_count>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2007-09-09</nyt:first_use>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-06-30</nyt:latest_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.john_podesta"/>
    <skos:prefLabel xml:lang="en">Podesta, John D</skos:prefLabel>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/p/john_d_podesta/index.html"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://data.nytimes.com/podesta_john_d_per"/>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BPodesta%2C+John+D%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <skos:definition xml:lang="en">John Podesta was co-chairman of President Obama's transition team. He served as chief of staff in the Clinton White House and led transition planning for the Obama campaign.
Mr. Podesta has extensive experience at both ends of Pennsylvania Avenue, and in the world of think tanks whose work often underlies policy initiatives. Under Mr. Clinton, he also served as staff secretary and deputy chief of staff, and he was an aide on Capitol Hill to Senators Tom Daschle of South Dakota and Patrick J. Leahy of Vermont. He is now president of the Center for American Progress, a liberal research group that he founded in 2003 with help from George Soros and other financiers, and that has effectively been a government in exile for Democrats.</skos:definition>
  </rdf:Description>
