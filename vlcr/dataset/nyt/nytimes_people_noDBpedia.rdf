    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/f/ella_fitzgerald/index.html"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-11-29</nyt:latest_use>
  </rdf:Description>
