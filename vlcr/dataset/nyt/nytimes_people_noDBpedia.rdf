  <rdf:Description rdf:about="http://data.nytimes.com/N75304153552356280953">
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-08-17</nyt:first_use>
    <skos:prefLabel xml:lang="en">Levy, Chandra Ann</skos:prefLabel>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.chandra_levy"/>
