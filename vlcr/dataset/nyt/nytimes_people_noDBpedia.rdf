  <rdf:Description rdf:about="http://data.nytimes.com/272306497240199773">
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.marcia_gay_harden"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/h/marcia_gay_harden/index.html"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-07-22</nyt:first_use>
    <skos:definition xml:lang="en">Marcia Gay Harden won an Oscar as best supporting actress for her role as Lee Krasner, Jackson Pollock's artist wife, opposite Ed Harris in "Pollock" (2000) and was nominated for a best supporting-actress Oscar for playing Tim Robbins's wife in Clint Eastwood's "Mystic River" (2003). She also received a best-featured-actress Tony nomination for portraying a pill-popping Mormon agoraphobe in Tony Kushner's "Angels in America: Millennium Approaches" on Broadway (1993).
Ms. Harden grew up as the daughter of a Navy captain, living in Japan, Greece, Germany and all over the United States, forever a new kid in a new town, playing catch-up. ''It was horribly embarrassing,'' she once said. ''I had a uni-brow. My sisters and I wore out-of-date clothing, matching dresses. It was a very strict family, and we were very mindful of our parents' wishes. So what happens is, you go away to college and then all hell breaks loose.''</skos:definition>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</nyt:associated_article_count>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-09-27</nyt:latest_use>
    <owl:sameAs rdf:resource="http://data.nytimes.com/harden_marcia_gay_per"/>
