  <rdf:Description rdf:about="http://data.nytimes.com/87022308807550067493">
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <skos:definition xml:lang="en">The status of James Joyce as a writer never could be determined in his lifetime. In the opinion of some critics, notably Edmund Wilson, he deserved to rank with the great innovators of literature as one whose influence upon other writers of his time was incalculable. On the other hand, there were critics like Max Eastman who gave him a place with Gertrude Stein and T.S. Eliot among the "Unintelligibles" and there was Professor Irving Babbitt of Harvard who dismissed his most widely read novel, "Ulysses," as one which only could have been written "in an advanced stage of psychic disintegration."</skos:definition>
    <skos:prefLabel xml:lang="en">Joyce, James</skos:prefLabel>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.james_joyce"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/joyce_james_per"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-04-11</nyt:first_use>
