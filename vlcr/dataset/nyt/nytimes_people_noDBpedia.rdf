  <rdf:Description rdf:about="http://data.nytimes.com/N25891960201920881663">
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.richard_greenberg"/>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BGreenberg%2C+Richard%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-02-08</nyt:latest_use>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-07-29</nyt:first_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <skos:prefLabel xml:lang="en">Greenberg, Richard</skos:prefLabel>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">14</nyt:associated_article_count>
    <skos:definition xml:lang="en">The playwright Richard Greenberg, known for his searing intellect and lightning wit, has been compared to Noel Coward and Philip Barry. Mr. Greenberg, 50, has written his share of high-toned, upper-middle-class comedy-dramas, but his work avoids a specific milieu, either drawing on historical characters or events as inspiration — the Collyer Brothers, Maxwell Perkins, Truman Capote's Black and White Ball — or landing in a major-league locker room.
While the settings are never predictable, the high literary quality of the writing is. Mr. Greenberg's best lines are simultaneously funny and smart, managing to elude bitchiness without sacrificing bite. In ''Eastern Standard,'' when two siblings discuss their conservative mother, one says, ''There's not a revolution in history that would have failed to execute her.'' And in ''The Extra Man,'' one character describes another's emotional tirade as ''Medea minus the sense of proportion.''</skos:definition>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://data.nytimes.com/greenberg_richard_per"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/g/richard_greenberg/index.html"/>
  </rdf:Description>
