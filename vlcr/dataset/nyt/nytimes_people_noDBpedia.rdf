  <rdf:Description rdf:about="http://data.nytimes.com/N33114440405533239623">
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-11-27</nyt:first_use>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <skos:prefLabel xml:lang="en">Robertson, David</skos:prefLabel>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/r/david_robertson/index.html"/>
    <skos:definition xml:lang="en">David Robertson has been the music director of the Saint Louis Symphony Orchestra since 2005. He is also principal guest conductor of the BBC Symphony Orchestra, a post to which he was appointed in 2005.
Mr. Robertson has been highly praised for his work with 20th- and 21st-century music, and has frequently conducted the New York Philharmonic, as well as many other orchestras in the United States and around the world.
He is at the top of the ranks of a generation of American conductors who -- in a reversal of the tide that brought Toscanini, Ormandy, Szell and Solti to the United States -- established themselves in Europe. Mr. Robertson?s European career was heavily weighted toward new music.</skos:definition>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-06-29</nyt:latest_use>
    <owl:sameAs rdf:resource="http://data.nytimes.com/robertson_david_per"/>
