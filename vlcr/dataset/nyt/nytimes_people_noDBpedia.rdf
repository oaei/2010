  <rdf:Description rdf:about="http://data.nytimes.com/47199679504802273893">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Boulud, Daniel</skos:prefLabel>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.daniel_boulud"/>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BBoulud%2C+Daniel%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">19</nyt:associated_article_count>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-10-14</nyt:latest_use>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-12-17</nyt:first_use>
    <skos:definition xml:lang="en">Daniel Boulud achieved culinary fame in the late 1980s and early 1990s as the executive chef at Le Cirque, Sirio Maccioni's glamour-filled restaurant, which was then in the Mayfair Hotel on East 65th Street and for more than 20 years, until the mid-1990s, was the dining spot of choice for Manhattan society and celebrity. It was a frequent evening destination for the likes of Jacqueline Onassis, Barbara Walters, Beverly Sills and the Duchess of York.
Mr. Boulud left Le Cirque in 1992 (he had just earned four stars, the highest rating, from The New York Times) and opened his own restaurant, Daniel, on East 76th Street. In 1994, Ruth Reichl of The Times awarded Daniel four stars. In 1997, after Le Cirque moved to the Palace Hotel, Mr. Boulud bought the old Le Cirque space and moved Daniel there, turning the East 76th Street site into Café Boulud, a more informal restaurant.</skos:definition>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/b/daniel_boulud/index.html"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/boulud_daniel_per"/>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
  </rdf:Description>
