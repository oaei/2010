  <rdf:Description rdf:about="http://data.nytimes.com/N10507958644473712303">
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">11</nyt:associated_article_count>
    <skos:prefLabel xml:lang="en">Atwood, Margaret</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/atwood_margaret_per"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/a/margaret_atwood/index.html"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-09-22</nyt:latest_use>
    <skos:definition xml:lang="en">Margaret Atwood, the celebrated Canadian writer, is known for her dystopian speculations about where mankind will go in its quest for a perfect society and her exploration of themes like female competition.
Her latest novel "The Year of the Flood," (Nan A. Talese/Doubleday), was published in this country on Sept. 22 and greeted with a bouquet of glowing reviews, enhancing her reputation as a writer with an ironic wit and a mastery of big ideas.
"The Year of the Flood," about a violent future society created by a man-made plague, which has genetically-engineered humans and animals amid a ruined environment, was the latest example of what Ms. Atwood calls "speculative fiction," the most famous being the now-classic "The Handmaid's Tale," set in a right-wing, future theocracy.</skos:definition>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-03-06</nyt:first_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.margaret_atwood"/>
