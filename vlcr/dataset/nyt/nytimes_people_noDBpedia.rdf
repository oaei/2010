    <skos:prefLabel xml:lang="en">Simic, Charles</skos:prefLabel>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2007-08-02</nyt:first_use>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/simic_charles_per"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/s/charles_simic/index.html"/>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</nyt:associated_article_count>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-07-17</nyt:latest_use>
    <skos:definition xml:lang="en">Charles Simic, a writer who juxtaposes dark imagery with ironic humor, is one of the nation's most prominent poets, and served as the 15th United States poet laureate, from Aug. 2, 2007 to July 17, 2008.
Mr. Simic, 69, was born in Belgrade, Yugoslavia, and immigrated to the United States at 16. He started writing poetry in English only a few years after learning the language and has published more than 20 volumes of poetry, as well as essay collections, translations and a memoir.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.nytimes.com/91906139176992497093">
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BPanetta%2C+Leon+E%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">7</nyt:associated_article_count>
    <owl:sameAs rdf:resource="http://data.nytimes.com/panetta_leon_e_per"/>
    <skos:definition xml:lang="en">Updated June 9, 2009
Leon E. Panetta, a longtime California Congressman who brought order to the Clinton White House as chief of staff, is the director of the Central Intelligence Agency.
Mr. Panetta has a reputation in Washington as a competent manager with a strong background in budget issues, but his selection as C.I.A. chief was a surprise as he had little hands-on intelligence experience.
In May 2009, a behind-the-scenes power struggle erupted between Mr. Panetta and Dennis C. Blair, the director of national intelligence, after Mr. Blair sent a classified memorandum announcing that his office would use its authority to select the top American spy in each country overseas.</skos:definition>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-09-19</nyt:first_use>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
