  <rdf:Description rdf:about="http://data.nytimes.com/46269070461194848993">
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <skos:definition xml:lang="en">Dexter Filkins, a foreign correspondent for The New York Times, was based in the newspaper's Baghdad bureau from the beginning of the war in March 2003 until September 2006. Mr. Filkins recently returned to Iraq for a story for The New York Times Magazine. Before the Iraq war, Mr. Filkins was based in Istanbul and in Afghanistan, where he covered the war in 2001 and 2002.
In 2005, Mr. Filkins received the George Polk Award for war coverage for his reports on the eight-day attack on Iraqi insurgents in Falluja that left 51 American marines dead, six of them in Bravo Company, with which he was embedded. The Polk Award jurors said his accounts of street-to-street fighting "conveyed the hellish intensity of urban warfare." In 2002, he was a finalist for the Pulitzer Prize in international reporting for his dispatches from Afghanistan.</skos:definition>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.dexter_filkins"/>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-10-10</nyt:first_use>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">12</nyt:associated_article_count>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/f/dexter_filkins/index.html"/>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-06-28</nyt:latest_use>
