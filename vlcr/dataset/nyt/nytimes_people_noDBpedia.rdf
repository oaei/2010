  <rdf:Description rdf:about="http://data.nytimes.com/8032611645831145973">
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">14</nyt:associated_article_count>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</nyt:number_of_variants>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/h/leona_helmsley/index.html"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/helmsley_leona_per"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Leona Helmsley made herself into a household name by starring in advertisements for the hotels owned by herself and her third husband, Harry Helmsley, in which she grandly proclaimed herself "the queen." It was a phrase that bit back after she became embroiled in a well-publicized tax scandal, as the New York tabloids dubbed her "the queen of mean."
Together with Mr. Helmsley, and on her own after his death, Mrs. Helmsley was a significant figure in Manhattan's real-estate scene for decades, with holdings that included the Empire State building. But she became far better known as a symbol of ostentatious, overbearing wealth after the couple was indicted on charges that they had evaded more than $4 million in income taxes. Prosecutors charged that they fraudulently claimed personal luxuries as business expenses, including a $45,00 silver clock and a $210,000 mahogany card table for their Greenwich, Conn., mansion.</skos:definition>
    <skos:prefLabel xml:lang="en">Helmsley, Leona</skos:prefLabel>
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-08-11</nyt:latest_use>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
