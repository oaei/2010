  <rdf:Description rdf:about="http://data.nytimes.com/74027205508232093983">
    <skos:prefLabel xml:lang="en">McCollum, Bill</skos:prefLabel>
    <nyt:search_api_query rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.nytimes.com/svc/search/v1/article?query=+nytd_per_facet%3A%5BMcCollum%2C+Bill%5D&amp;rank=newest&amp;fields=abstract,author,body,byline,classifiers_facet,column_facet,date,day_of_week_facet,des_facet,desk_facet,fee,geo_facet,lead_paragraph,material_type_facet,multimedia,nytd_byline,nytd_des_facet,nytd_geo_facet,nytd_lead_paragraph,nytd_org_facet,nytd_per_facet,nytd_section_facet,nytd_title,nytd_works_mentioned_facet,org_facet,page_facet,per_facet,publication_day,publication_month,publication_year,section_page_facet,small_image_height,small_image_url,small_image_width,source_facet,title,url,word_count,works_mentioned_facet</nyt:search_api_query>
    <nyt:first_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2007-11-15</nyt:first_use>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.bill_mccollum"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/reference/timestopics/people/m/bill_mccollum/index.html"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Updated May 20, 2009
Bill McCollum, a Republican, has served as Florida's attorney general since 2006. On May 18, 2009, Mr. McCollum announced his candidacy for governor, setting the stage for a battle with Alex Sink, the state's chief financial officer and a Democrat. Backed by their parties, both candidates are considered front-runners.
Mr. McCollum spent two decades in Congress, where he fought to impeach President Bill Clinton.
At a news conference where he announced his candidacy, Mr. McCollum, for years considered Florida's ultimate conservative, cast himself as a pragmatist. Some political analysts say the establishment ties that help Mr. McCollum with endorsements and contributions may make it hard for him to fashion a new image. He has already lost two campaigns for the Senate, and some Republicans say they fear that voters have made up their minds about him.</skos:definition>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</nyt:associated_article_count>
    <skos:inScheme rdf:resource="http://data.nytimes.com/elements/nytd_per"/>
    <owl:sameAs rdf:resource="http://data.nytimes.com/mccollum_bill_per"/>
