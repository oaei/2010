  <rdf:Description rdf:about="http://data.nytimes.com/N27949889755820045621">
    <nyt:latest_use rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-06-25</nyt:latest_use>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <nyt:number_of_variants rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</nyt:number_of_variants>
    <owl:sameAs rdf:resource="http://data.nytimes.com/sadr_city_iraq_geo"/>
    <nyt:topicPage rdf:resource="http://topics.nytimes.com/top/news/international/countriesandterritories/iraq/sadr_city/index.html"/>
    <owl:sameAs rdf:resource="http://rdf.freebase.com/ns/en.sadr_city"/>
    <skos:definition xml:lang="en">Sadr City is a vast, dense, predominantly Shiite slum in eastern Baghad that is the stronghold of Moktada al-Sadr, the firebrand cleric, and the Mahdi Army, the militia loyal to him.
The area was the scene of intense fighting between American forces and Mahdi Army fighters in 2004. In April 2008, Prime Minister Nuri al-Maliki ordered the Iraqi Army, backed by American soldiers and gunships, to move into Sadr City, which had been operating as essentially an autonomous fiefdom. The move led to weeks of fierce battles.</skos:definition>
    <skos:prefLabel xml:lang="en">Sadr City (Iraq)</skos:prefLabel>
    <nyt:associated_article_count rdf:datatype="http://www.w3.org/2001/XMLSchema#int">34</nyt:associated_article_count>
